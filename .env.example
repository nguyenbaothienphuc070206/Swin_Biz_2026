# Server only. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Required when wiring protected API routes to Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set by the chosen shared rate-limit adapter at deployment.
AI_RATE_LIMIT_BACKEND=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_HASH_SECRET=
AI_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# AI budgets are required before enabling AI routes. Amounts are integer micro-USD.
# Example: 1 USD = 1,000,000 micro-USD. Set caps approved by product/finance.
AI_DAILY_GLOBAL_BUDGET_MICRO_USD=
AI_DAILY_USER_BUDGET_MICRO_USD=
# Reserve worst-case cost per request before calling Claude; tune for retries/token bounds.
AI_MAX_REQUEST_RESERVATION_MICRO_USD=
# Claude Sonnet 4.5 API standard rates verified on 2026-10-10; review on model/price changes.
AI_INPUT_USD_PER_MILLION_TOKENS=3
AI_OUTPUT_USD_PER_MILLION_TOKENS=15

# Keep disabled until thresholds and escalation procedure are approved.
ALERT_BP_ENABLED=false
ALERT_BP_SYSTOLIC_HIGH=
ALERT_BP_DIASTOLIC_HIGH=
ALERT_BP_SEVERITY=
